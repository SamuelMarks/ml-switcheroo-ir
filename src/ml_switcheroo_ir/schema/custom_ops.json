{
  "ops": [
    {
      "name": "RMSNorm",
      "domain": "ml.switcheroo.custom",
      "inputs": ["X", "weight"],
      "outputs": ["Y"],
      "attributes": [
        {
          "name": "eps",
          "type": "float",
          "required": false,
          "default": 1e-06
        }
      ]
    },
    {
      "name": "SwiGLU",
      "domain": "ml.switcheroo.custom",
      "inputs": ["X"],
      "outputs": ["Y"],
      "attributes": [
        {
          "name": "dim",
          "type": "int",
          "required": false,
          "default": -1
        }
      ]
    },
    {
      "name": "RoPE",
      "domain": "ml.switcheroo.custom",
      "inputs": ["X", "cos", "sin"],
      "outputs": ["Y"],
      "attributes": [
        {
          "name": "dim",
          "type": "int",
          "required": false,
          "default": -1
        }
      ]
    },
    {
      "name": "FlashAttention",
      "domain": "ml.switcheroo.custom",
      "inputs": ["Q", "K", "V"],
      "outputs": ["Y"],
      "attributes": [
        {
          "name": "causal",
          "type": "bool",
          "required": false,
          "default": false
        },
        {
          "name": "scale",
          "type": "float",
          "required": false,
          "default": null
        }
      ]
    },
    {
      "name": "VisionPatchEmbedding",
      "domain": "ml.switcheroo.custom",
      "inputs": ["X", "weight"],
      "outputs": ["Y"],
      "attributes": [
        {
          "name": "patch_size",
          "type": "List[int]",
          "required": true
        },
        {
          "name": "embed_dim",
          "type": "int",
          "required": true
        }
      ]
    },
    {
      "name": "ScaledDotProductAttention",
      "domain": "ml.switcheroo.custom",
      "inputs": ["query", "key", "value", "attn_mask"],
      "outputs": ["output"],
      "attributes": [
        {
          "name": "scale",
          "type": "float",
          "required": false,
          "default": null
        },
        {
          "name": "dropout_p",
          "type": "float",
          "required": false,
          "default": 0.0
        },
        {
          "name": "is_causal",
          "type": "bool",
          "required": false,
          "default": false
        }
      ]
    },
    {
      "name": "LayerNorm",
      "domain": "ml.switcheroo.custom",
      "inputs": ["X", "scale", "bias"],
      "outputs": ["Y"],
      "attributes": [
        {
          "name": "axis",
          "type": "int",
          "required": false,
          "default": -1
        },
        {
          "name": "epsilon",
          "type": "float",
          "required": false,
          "default": 1e-05
        },
        {
          "name": "elementwise_affine",
          "type": "bool",
          "required": false,
          "default": true
        }
      ]
    },
    {
      "name": "GroupNorm",
      "domain": "ml.switcheroo.custom",
      "inputs": ["X", "scale", "bias"],
      "outputs": ["Y"],
      "attributes": [
        {
          "name": "num_groups",
          "type": "int",
          "required": true
        },
        {
          "name": "epsilon",
          "type": "float",
          "required": false,
          "default": 1e-05
        }
      ]
    },
    {
      "name": "GELU",
      "domain": "ml.switcheroo.custom",
      "inputs": ["X"],
      "outputs": ["Y"],
      "attributes": [
        {
          "name": "approximate",
          "type": "str",
          "required": false,
          "default": "none"
        }
      ]
    },
    {
      "name": "EmbeddingLookup",
      "domain": "ml.switcheroo.custom",
      "inputs": ["indices", "weight"],
      "outputs": ["output"],
      "attributes": [
        {
          "name": "padding_idx",
          "type": "int",
          "required": false,
          "default": null
        },
        {
          "name": "scale_grad_by_freq",
          "type": "bool",
          "required": false,
          "default": false
        }
      ]
    },
    {
      "name": "RMSNormBackward",
      "domain": "ml.switcheroo.custom",
      "inputs": ["grad_output", "X", "weight"],
      "outputs": ["grad_X", "grad_weight"],
      "attributes": [
        {
          "name": "eps",
          "type": "float",
          "required": false,
          "default": 1e-06
        }
      ]
    }
  ]
}
